  "description": "千川 Electron 桌面应用",
  "main": "src/main.js",
  "scripts": {
    "start": "npm run build:renderer && electron .",
    "version": "electron --version",
    "dev": "npm run build:renderer && electron .",
    "build:renderer": "vite build --config vite.config.mts",
    "typecheck": "tsc --noEmit",
