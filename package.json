{
  "name": "qianchuan-electron",
  "version": "1.0.0",
  "description": "千川 Electron 桌面应用",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "version": "electron --version",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "vite build --config vite.config.mts",
    "build:preload": "vite build --config vite.preload.config.mts",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:electron",
    "test": "vitest run --config vitest.config.mts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,html}\" \"scripts/**/*.mjs\" package.json README.md \"tsconfig*.json\" vite.config.mts vite.preload.config.mts vitest.config.mts",
    "build:electron": "npm run clean:electron && tsc -p tsconfig.electron.json && npm run build:preload",
    "dev:renderer": "vite --config vite.config.mts --host 127.0.0.1 --port 5173 --strictPort",
    "dev:electron": "npm run build:electron && wait-on http://127.0.0.1:5173 && node scripts/dev-electron.mjs",
    "typecheck:renderer": "tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run build:renderer && npm run build:electron",
    "clean:electron": "node scripts/clean-electron.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  },
  "private": true,
  "dependencies": {
    "@arco-design/web-react": "^2.66.16",
    "@tanstack/react-query": "^5.102.8",
    "dayjs": "^1.11.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  }
}
