{
  "name": "qianchuan-electron",
  "version": "1.0.0",
  "description": "千川 Electron 桌面应用",
  "main": "dist-electron/main.js",
  "scripts": {
    "start": "npm run build && electron .",
    "version": "electron --version",
    "dev": "concurrently -k \"npm:dev:renderer\" \"npm:dev:electron\"",
    "build:renderer": "vite build --config vite.config.mts",
    "typecheck": "npm run typecheck:renderer && npm run typecheck:electron",
    "test": "vitest run",
    "format:check": "prettier --check \"src/main.ts\" \"src/preload.ts\" \"src/renderer/App.tsx\" \"src/renderer/app/*.{ts,tsx}\" \"src/renderer/features/placeholder/**/*.tsx\" \"src/renderer/features/promotion-monitor/**/*.{ts,tsx}\" \"src/renderer/layouts/WorkspaceLayout/**/*.tsx\" \"src/renderer/shared/ui/*.ts\" vite.config.mts \"tsconfig*.json\" package.json",
    "build:electron": "tsc -p tsconfig.electron.json",
    "dev:renderer": "vite --config vite.config.mts --host 127.0.0.1 --port 5173",
    "dev:electron": "npm run build:electron && wait-on http://127.0.0.1:5173 && cross-env QIANCHUAN_RENDERER_URL=http://127.0.0.1:5173 electron .",
    "typecheck:renderer": "tsc --noEmit",
    "typecheck:electron": "tsc -p tsconfig.electron.json --noEmit",
    "build": "npm run build:renderer && npm run build:electron"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.2.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wait-on": "^9.1.0"
  },
  "private": true,
  "dependencies": {
    "@arco-design/web-react": "^2.66.16",
    "@tanstack/react-query": "^5.102.8",
    "dayjs": "^1.11.23",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  }
}
